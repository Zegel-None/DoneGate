{
  "说明": "工件生成型节点（archetype: generator）：调用 Anchore Syft 生成 CycloneDX 标准 SBOM 清单并锁定产物 SHA-256 供下游漏洞覆盖族消费。",
  "tool": "syft",
  "registryId": "syft@stage4",
  "role": "soft",
  "stage": 4,
  "archetype": "generator",
  "upstream": {
    "repo": "anchore/syft",
    "extractMode": "cli",
    "homepage": "https://github.com/anchore/syft"
  },
  "install": {
    "kind": "binary",
    "repo": "anchore/syft",
    "version": "v1.18.0",
    "bin": "syft"
  },
  "card": {
    "title": "软件依赖清单盘点",
    "category": "安全与运维",
    "summary": "自动盘点项目用到的全部第三方开源依赖包与版本号，供下游查漏洞使用",
    "inputs": [
      {
        "id": "in_art",
        "name": "项目源码或安装包",
        "type": "ARTIFACT"
      }
    ],
    "outputs": [
      {
        "id": "out_sbom",
        "name": "第三方依赖清单",
        "type": "ARTIFACT"
      },
      {
        "id": "out_sig",
        "name": "是否盘点完成",
        "type": "SIGNAL"
      }
    ],
    "slots": [
      {
        "id": "sy_1",
        "label": "导出完整第三方依赖清单",
        "wired": true,
        "boundOut": "out_sbom"
      },
      {
        "id": "sy_2",
        "label": "统计各语言依赖包数量",
        "wired": true,
        "boundOut": "out_sig"
      }
    ]
  },
  "observables": [
    {
      "id": "componentCount",
      "from": "componentCount",
      "kind": "artifact",
      "assertableAs": [
        "non-empty"
      ],
      "wired": false,
      "reason": "SBOM 只产生物料清单不做漏洞判定，交由下游覆盖族扫描器消费"
    }
  ],
  "requiresProject": [],
  "blindSpots": [
    "仅枚举构建物与锁文件中的软件物料清单（SBOM），本身不查询漏洞库也不判定安全风险"
  ],
  "disposition": {
    "state": "advisory",
    "reason": "阶段 7 安全覆盖族上游 SBOM 生成节点"
  }
}
