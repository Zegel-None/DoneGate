      "bin": "ruff",
      "pkg": "ruff",
      "installCmd": "pip install --target workflows/.deps/03-api-contract-and-fuzz/venv ruff==0.8.4"
    },
    {
      "id": "schemathesis",
      "title": "Schemathesis OpenAPI 属性模糊测试",
