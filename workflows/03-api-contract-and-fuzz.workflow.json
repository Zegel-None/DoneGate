      "bin": "schemathesis",
      "pkg": "schemathesis",
      "installCmd": "pip install --target workflows/.deps/03-api-contract-and-fuzz/venv schemathesis==3.39.5"
    },
    {
      "id": "hurl",
      "title": "Hurl 纯文本链式 HTTP 场景回归",
      "repo": "Orange-OpenSource/hurl",
      "version": "v6.0.0",
      "kind": "binary",
      "bin": "hurl",
      "installCmd": "下载 Hurl v6.0.0 可执行文件至 workflows/.deps/03-api-contract-and-fuzz/.bin/hurl"
    }
