      "id": "spectral",
      "title": "Spectral OpenAPI/AsyncAPI 契约规则检查",
      "repo": "stoplightio/spectral",
      "version": "v6.14.2",
      "kind": "npm",
      "bin": "spectral",
      "pkg": "@stoplight/spectral-cli"
    },
    {
      "id": "pyright",
      "title": "Pyright 跨文件静态类型检查",
      "repo": "microsoft/pyright",
      "version": "v1.1.389",
      "kind": "npm",
      "bin": "pyright",
      "pkg": "pyright"
    },
    {
      "id": "ruff",
      "title": "Ruff Python AST 语法与未定义名拦截",
