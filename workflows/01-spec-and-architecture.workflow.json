      "repo": "srclight/srclight",
      "version": "v0.25.0",
      "kind": "pip",
      "bin": "srclight",
      "pkg": "srclight",
      "installCmd": "pip install --target workflows/.deps/01-spec-and-architecture/venv srclight==0.25.0"
    },
    {
      "id": "openspec",
      "title": "OpenSpec 规格审校工具",
      "repo": "Fission-AI/OpenSpec",
      "version": "v0.2.4",
      "kind": "npm",
      "bin": "openspec",
      "pkg": "@fission-ai/openspec"
    },
    {
      "id": "beads",
      "title": "Beads 任务依赖图拆解",
      "repo": "steveyegge/beads",
      "version": "v0.9.11",
      "kind": "go",
      "bin": "bd",
      "installCmd": "go install github.com/steveyegge/beads/cmd/bd@v0.9.11"
    }
  ],
