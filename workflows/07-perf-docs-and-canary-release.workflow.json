{
  "id": "07-perf-docs-and-canary-release",
  "group": "专项覆盖族与发布流",
  "name": "07 · 阶段 8–10 · 接口压测、文档巡检与灰度放量流",
  "tip": "单次探针不挂常驻进程：接口响应压测探针 → 压测结果分流（缺环境自动转人工审批） → 术语与死链巡检 → 文档巡检裁决分流（违规打回修文档 / 通过进入更新日志） → 更新日志与回退单 → 上线放量人工审批 → 灰度放量健康抽检。",
  "deps": [
    {
      "id": "k6",
      "title": "接口响应压测引擎",
      "repo": "grafana/k6",
      "version": "v0.55.0",
      "kind": "binary",
      "bin": "k6",
      "installCmd": "下载 grafana/k6 v0.55.0 至 workflows/.deps/07-perf-docs-and-canary-release/.bin/k6"
    },
    {
      "id": "vale",
      "title": "文档术语与用词一致性检查器",
      "repo": "errata-ai/vale",
      "version": "v3.9.3",
      "kind": "binary",
      "bin": "vale",
      "installCmd": "下载 errata-ai/vale v3.9.3 至 workflows/.deps/07-perf-docs-and-canary-release/.bin/vale"
    },
    {
      "id": "lychee",
      "title": "文档失效死链扫描器",
      "repo": "lycheeverse/lychee",
      "version": "v0.17.0",
      "kind": "binary",
      "bin": "lychee",
      "installCmd": "下载 lycheeverse/lychee v0.17.0 至 workflows/.deps/07-perf-docs-and-canary-release/.bin/lychee"
    },
    {
      "id": "git-cliff",
      "title": "版本更新日志自动生成器",
      "repo": "orhun/git-cliff",
      "version": "v2.7.0",
      "kind": "binary",
      "bin": "git-cliff",
      "installCmd": "下载 orhun/git-cliff v2.7.0 至 workflows/.deps/07-perf-docs-and-canary-release/.bin/git-cliff"
    },
    {
      "id": "flagger",
      "title": "灰度发布状态单次查询工具",
      "repo": "fluxcd/flagger",
      "version": "v1.39.0",
      "kind": "binary",
      "bin": "kubectl",
      "installCmd": "配置 kubectl 单次查询灰度状态快照（严禁阻塞常驻监听）"
    }
  ],
  "groups": [
