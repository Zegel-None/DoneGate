      "version": "v0.55.0",
      "kind": "binary",
      "bin": "k6",
      "installCmd": "下载 grafana/k6 v0.55.0 至 workflows/.deps/07-perf-docs-and-canary-release/.bin/k6"
    },
    {
      "id": "vale",
      "title": "Vale 技术文档术语与文风检查",
      "repo": "errata-ai/vale",
      "version": "v3.9.3",
      "kind": "binary",
      "bin": "vale",
      "installCmd": "下载 errata-ai/vale v3.9.3 至 workflows/.deps/07-perf-docs-and-canary-release/.bin/vale"
    },
    {
      "id": "lychee",
      "title": "Lychee 文档与锚点死链扫描器",
      "repo": "lycheeverse/lychee",
      "version": "v0.17.0",
      "kind": "binary",
      "bin": "lychee",
      "installCmd": "下载 lycheeverse/lychee v0.17.0 至 workflows/.deps/07-perf-docs-and-canary-release/.bin/lychee"
    },
    {
      "id": "git-cliff",
      "title": "Git-Cliff 约定式提交变更日志生成器",
      "repo": "orhun/git-cliff",
      "version": "v2.7.0",
      "kind": "binary",
      "bin": "git-cliff",
      "installCmd": "下载 orhun/git-cliff v2.7.0 至 workflows/.deps/07-perf-docs-and-canary-release/.bin/git-cliff"
    },
    {
      "id": "flagger",
      "title": "Flagger 渐进式金丝雀发布控制器（单次状态快照查询）",
      "repo": "fluxcd/flagger",
      "version": "v1.39.0",
      "kind": "binary",
      "bin": "kubectl",
      "installCmd": "配置 kubectl 只读快照查询金丝雀 Canary CRD 状态（严禁阻塞常驻监听）"
