        { "id": "s_1", "label": "1 号口回流修正 SQL (maxLoops=3)", "wired": true, "boundOut": "out_1" },
        { "id": "s_3", "label": "2/3 号口输出环境就绪工单", "wired": true, "boundOut": "out_3" }
      ]
    },
    {
