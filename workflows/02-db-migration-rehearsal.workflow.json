      "slots": [{ "id": "hg_1", "label": "DBA/业主确认回滚预案完备", "wired": true, "boundOut": "out_go" }]
    }
  ],
  "links": [
    { "id": "db-lk-1", "fromNode": "db-sqlfluff", "fromSlot": "out_sql", "toNode": "db-flyway-truth", "toSlot": "in_sql", "type": "ARTIFACT" },
    { "id": "db-lk-2", "fromNode": "db-flyway-truth", "fromSlot": "out_schema", "toNode": "db-atlas-readonly", "toSlot": "in_schema", "type": "ARTIFACT" },
