      "repoSlug": "ariga/atlas",
      "repoUrl": "https://github.com/ariga/atlas",
      "pinnedVersion": "v0.29.0",
      "latestUpstream": "v0.30.0",
      "requiresDep": true,
      "bin": "atlas",
      "isBlank": false,
      "isHumanGate": false,
