      "slots": [
        {
          "id": "fw_1",
          "label": "空库正反向升级无报错",
          "wired": true,
          "boundOut": "out_schema"
        },
        {
          "id": "fw_2",
          "label": "核对升级历史记录完整",
          "wired": true,
          "boundOut": "out_log"
        }
      ]
    },
    {
      "id": "db-atlas-readonly",
