      "title": "Gitleaks 密钥硬编码扫描",
      "repo": "gitleaks/gitleaks",
      "version": "v8.21.2",
      "kind": "binary",
      "bin": "gitleaks",
      "installCmd": "下载 gitleaks v8.21.2 至 workflows/.deps/06-security-coverage-family/.bin/gitleaks"
    },
    {
      "id": "syft",
      "title": "Syft CycloneDX SBOM 生成器",
      "repo": "anchore/syft",
      "version": "v1.18.1",
      "kind": "binary",
      "bin": "syft",
      "installCmd": "下载 anchore/syft v1.18.1 至 workflows/.deps/06-security-coverage-family/.bin/syft"
    },
    {
      "id": "osv-scanner",
      "title": "OSV-Scanner 锁文件漏洞扫描",
      "repo": "google/osv-scanner",
      "version": "v1.9.2",
      "kind": "go",
      "bin": "osv-scanner",
      "installCmd": "go install github.com/google/osv-scanner/cmd/osv-scanner@v1.9.2"
    },
    {
      "id": "trivy",
      "title": "Trivy 容器层与 IaC 错误配置扫描",
      "repo": "aquasecurity/trivy",
      "version": "v0.59.1",
      "kind": "binary",
      "bin": "trivy",
      "installCmd": "下载 aquasecurity/trivy v0.59.1 至 workflows/.deps/06-security-coverage-family/.bin/trivy"
    },
    {
