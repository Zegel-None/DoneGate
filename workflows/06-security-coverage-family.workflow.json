{
  "id": "06-security-coverage-family",
  "group": "专项覆盖族与发布流",
  "name": "06 · 阶段 7 · 供应链与安全覆盖族去重归并流",
  "tip": "安全独立于功能测试（SusVibes 实证红线）：Gitleaks 密钥零容忍 → Syft 产出 CycloneDX SBOM → OSV-Scanner 锁文件扫描 → Trivy IaC/镜像扫描 → Semgrep 快速 SAST → 内置 vuln-merge 多源去重与可达性 P0-P3 定级 → 3 轮回修 → 人工高危处置闸门。",
  "deps": [
    {
      "id": "gitleaks",
      "title": "Gitleaks 密钥硬编码扫描",
      "repo": "gitleaks/gitleaks",
      "version": "v8.21.2",
      "kind": "binary",
      "bin": "gitleaks",
      "installCmd": "下载 gitleaks v8.21.2 至 workflows/.deps/06-security-coverage-family/.bin/gitleaks"
    },
    {
      "id": "syft",
      "title": "Syft CycloneDX SBOM 生成器",
      "repo": "anchore/syft",
      "version": "v1.18.1",
      "kind": "binary",
      "bin": "syft",
      "installCmd": "下载 anchore/syft v1.18.1 至 workflows/.deps/06-security-coverage-family/.bin/syft"
    },
    {
      "id": "osv-scanner",
      "title": "OSV-Scanner 锁文件漏洞扫描",
      "repo": "google/osv-scanner",
      "version": "v1.9.2",
      "kind": "go",
      "bin": "osv-scanner",
      "installCmd": "go install github.com/google/osv-scanner/cmd/osv-scanner@v1.9.2"
    },
    {
      "id": "trivy",
      "title": "Trivy 容器层与 IaC 错误配置扫描",
      "repo": "aquasecurity/trivy",
      "version": "v0.59.1",
      "kind": "binary",
      "bin": "trivy",
      "installCmd": "下载 aquasecurity/trivy v0.59.1 至 workflows/.deps/06-security-coverage-family/.bin/trivy"
    },
    {
      "id": "semgrep",
      "title": "Semgrep 多语言快速 SAST",
      "repo": "semgrep/semgrep",
      "version": "v1.101.0",
      "kind": "pip",
      "bin": "semgrep",
      "pkg": "semgrep",
      "installCmd": "pip install --target workflows/.deps/06-security-coverage-family/venv semgrep==1.101.0"
    }
